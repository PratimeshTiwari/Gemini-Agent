# Agent runtime state (per-workspace). Everything the agent writes lives here.
.agent/

# Legacy state dirs, migrated into .agent/ on startup. Kept ignored so old
# checkouts don't re-commit them.
.gemini/
.gemini-agent/
.agent-github-plans/

# Editor settings — the companion is installed from the .vsix, not recommended by id.
.vscode/

# Local working notes, not part of the repo. Both are batons rather than
# documentation: TEST.md is a checklist for one manual run, and HANDOFF.md is
# what the next session needs to know and is meant to be deleted once it does.
# The durable versions of what they hold live in CLAUDE.md and README.md.
TEST.md
HANDOFF.md
