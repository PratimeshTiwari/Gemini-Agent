{
  "manifest_version": 3,
  "name": "Agent CLI Bridge",
  "version": "1.24.0",
  "description": "Connects the local Agent CLI to your gemini.google.com session.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://github.com/*"
  ],
  "side_panel": {
    "default_path": "side-panel/panel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content-scripts/gemini-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content-scripts/github-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Agent CLI Bridge",
    "default_popup": "side-panel/panel.html?popup=1"
  }
}
