{
  "name": "cli-agent-companion",
  "displayName": "Agent CLI Companion",
  "description": "Editor state, diagnostics, Add to Agent Chat, and plan review for the local Agent CLI.",
  "version": "1.6.0",
  "publisher": "pratimesh-tiwari",
  "author": {
    "name": "Pratimesh Tiwari"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "agentCli.addToChat",
        "title": "Add to Agent Chat",
        "category": "Agent CLI",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "agentCli.openPlan",
        "title": "Open Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.approvePlan",
        "title": "Approve Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.submitReview",
        "title": "Submit Plan Review",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.rejectPlan",
        "title": "Reject Plan",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.commentOnPlan",
        "title": "Comment on Plan Section",
        "category": "Agent CLI"
      },
      {
        "command": "agentCli.watchTerminal",
        "title": "Watch This Terminal for Failures",
        "category": "Agent CLI",
        "icon": "$(eye)"
      }
    ],
    "keybindings": [
      {
        "command": "agentCli.addToChat",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1",
          "when": "editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "agentCli.commentOnPlan",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1",
          "when": "editorTextFocus"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "agentCli.addToChat",
          "group": "navigation@1"
        }
      ],
      "terminal/context": [
        {
          "command": "agentCli.watchTerminal",
          "group": "navigation"
        }
      ],
      "terminal/title/context": [
        {
          "command": "agentCli.watchTerminal",
          "group": "navigation"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PratimeshTiwari/Gemini-Agent"
  }
}
